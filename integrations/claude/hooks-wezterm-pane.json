{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/$CLAUDE_CODE_SESSION_ID\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/idle\"}' 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/idle\"}' 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/$CLAUDE_CODE_SESSION_ID\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/working\"}' 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/working\"}' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/$CLAUDE_CODE_SESSION_ID\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/idle\"}' 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/idle\"}' 2>/dev/null || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/$CLAUDE_CODE_SESSION_ID\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/waiting\"}' 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/waiting\"}' 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X DELETE \"http://localhost/devices/uid-440d6644c3b0438c/keys/$CLAUDE_CODE_SESSION_ID\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"color\":\"#000000\"}' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
